# Mailchimp Configuration
# Get these values from your Mailchimp account:
# 1. Go to Account > Extras > API keys to get your API key
# 2. The server prefix is the part after the dash in your API key (e.g., if your key ends with -us1, then us1 is your server prefix)
# 3. Go to Audience > Settings > Audience name and campaign defaults to find your Audience ID

# Mailchimp API Key (required)
VITE_MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Mailchimp Audience/List ID (required)
VITE_MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# Mailchimp Server Prefix (required - usually us1, us2, etc.)
VITE_MAILCHIMP_SERVER_PREFIX=us1

# Development Configuration
# Set to 'true' to enable development mode (uses console.log instead of actual API calls)
VITE_NEWSLETTER_DEV_MODE=false