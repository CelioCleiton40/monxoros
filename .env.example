# Google Sheets Configuration
# Get this URL from your Google Apps Script deployment:
# 1. Create a Google Sheet with columns: Nome | Email | Data
# 2. Go to Extensions > Apps Script
# 3. Create the newsletter script and deploy as web app
# 4. Copy the deployment URL here

# Google Sheets API URL (required)
VITE_GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/AKfycbxRAG5eN-Kn28Pa0YjbNgtkEIxcwTW6NOH6MHNDwavwtOEp7Xf22OT0IDL43Bwuvg1f/exec
                           
# Development Configuration
# Set to 'true' to enable development mode (uses console.log instead of actual API calls)
VITE_NEWSLETTER_DEV_MODE=false